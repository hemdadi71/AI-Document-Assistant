POSTGRES_DB=ai_document_assistant
POSTGRES_USER=ai_doc_app
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433

# Browser authentication cookies
AUTH_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30

# Local development (HTTP). Set secure=true in production (HTTPS).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Optional: set only when frontend and API share a parent domain.
# AUTH_COOKIE_DOMAIN=.example.com

# Exact frontend origins; comma-separated if there are multiple.
FRONTEND_ORIGINS=http://localhost:3000
